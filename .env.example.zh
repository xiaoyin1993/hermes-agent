# Hermes Agent 环境配置
# 将此文件复制为 .env 并填入你的 API 密钥

# =============================================================================
# LLM 提供商（OpenRouter）
# =============================================================================
# OpenRouter 通过一个 API 提供对多种模型的访问
# 所有 LLM 调用都通过 OpenRouter —— 无需直接配置各提供商的密钥
# 获取密钥：https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# 默认模型在 ~/.hermes/config.yaml（model.default）中配置。
# 使用 'hermes model' 或 'hermes setup' 命令修改。
# LLM_MODEL 不再从 .env 读取 —— 此行仅作参考保留。
# LLM_MODEL=anthropic/claude-opus-4.6

# =============================================================================
# LLM 提供商（Google AI Studio / Gemini）
# =============================================================================
# 通过 Google 的 OpenAI 兼容端点原生使用 Gemini API。
# 获取密钥：https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=你的_google_ai_studio_密钥
# GEMINI_API_KEY=你的_gemini_密钥  # GOOGLE_API_KEY 的别名
# 可选的 API 地址覆盖（默认：Google 的 OpenAI 兼容端点）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# =============================================================================
# LLM 提供商（Ollama Cloud）
# =============================================================================
# 通过 Ollama 的 OpenAI 兼容端点使用云端开源模型。
# 获取密钥：https://ollama.com/settings
# OLLAMA_API_KEY=你的_ollama_密钥
# 可选的 API 地址覆盖（默认：https://ollama.com/v1）
# OLLAMA_BASE_URL=https://ollama.com/v1

# =============================================================================
# LLM 提供商（z.ai / GLM 智谱 AI）
# =============================================================================
# z.ai 提供对智谱 AI GLM 模型的访问（GLM-4-Plus 等）
# 获取密钥：https://z.ai 或 https://open.bigmodel.cn
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/paas/v4  # 覆盖默认 API 地址

# =============================================================================
# LLM 提供商（Kimi / Moonshot 月之暗面）
# =============================================================================
# Kimi Code 提供对 Moonshot AI 编程模型的访问（kimi-k2.5 等）
# 获取密钥：https://platform.kimi.ai（Kimi Code 控制台）
# sk-kimi- 前缀的密钥默认使用 Kimi Code API（api.kimi.com）。
# platform.moonshot.ai 的旧版密钥需要通过 KIMI_BASE_URL 覆盖。
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.kimi.com/coding/v1  # sk-kimi- 密钥的默认地址
# KIMI_BASE_URL=https://api.moonshot.ai/v1      # 旧版 Moonshot 密钥
# KIMI_BASE_URL=https://api.moonshot.cn/v1       # Moonshot 国内密钥
# KIMI_CN_API_KEY=                               # Moonshot 国内版专用密钥

# =============================================================================
# LLM 提供商（Arcee AI）
# =============================================================================
# Arcee AI 提供 Trinity 系列模型（trinity-mini, trinity-large-* 等）
# 获取密钥：https://chat.arcee.ai/
# ARCEEAI_API_KEY=
# ARCEE_BASE_URL=                                 # 覆盖默认 API 地址

# =============================================================================
# LLM 提供商（MiniMax）
# =============================================================================
# MiniMax 全球端点
# 获取密钥：https://www.minimax.io
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1  # 覆盖默认 API 地址

# MiniMax 中国大陆端点
# MINIMAX_CN_API_KEY=
# MINIMAX_CN_BASE_URL=https://api.minimaxi.com/v1  # 覆盖默认 API 地址

# =============================================================================
# LLM 提供商（OpenCode Zen）
# =============================================================================
# OpenCode Zen 提供经过测试的精选模型（GPT、Claude、Gemini、MiniMax、GLM、Kimi）
# 按量付费。获取密钥：https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1  # 覆盖默认 API 地址

# =============================================================================
# LLM 提供商（OpenCode Go）
# =============================================================================
# OpenCode Go 提供开源模型（GLM-5、Kimi K2.5、MiniMax M2.5）
# $10/月订阅制。获取密钥：https://opencode.ai/auth
# OPENCODE_GO_API_KEY=

# =============================================================================
# LLM 提供商（Hugging Face 推理服务）
# =============================================================================
# Hugging Face 通过统一的 OpenAI 兼容端点路由到 20+ 开源模型。
# 含免费层（$0.10/月），提供商费率无加价。
# 获取令牌：https://huggingface.co/settings/tokens
# 需要权限："Make calls to Inference Providers"
# HF_TOKEN=
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1  # 覆盖默认 API 地址

# =============================================================================
# LLM 提供商（通义千问 Qwen OAuth）
# =============================================================================
# Qwen OAuth 复用本地 Qwen CLI 登录凭证（qwen auth qwen-oauth）。
# 无需 API 密钥 —— 凭证来自 ~/.qwen/oauth_creds.json。
# 可选的 API 地址覆盖：
# HERMES_QWEN_BASE_URL=https://portal.qwen.ai/v1

# =============================================================================
# LLM 提供商（小米 MiMo）
# =============================================================================
# 小米 MiMo 模型（mimo-v2-pro、mimo-v2-omni、mimo-v2-flash）。
# 获取密钥：https://platform.xiaomimimo.com
# XIAOMI_API_KEY=你的密钥
# 可选的 API 地址覆盖：
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# =============================================================================
# 工具 API 密钥
# =============================================================================

# Exa API 密钥 - AI 原生网页搜索与内容提取
# 获取地址：https://exa.ai
# EXA_API_KEY=

# Parallel API 密钥 - AI 原生网页搜索与提取
# 获取地址：https://parallel.ai
# PARALLEL_API_KEY=

# Firecrawl API 密钥 - 网页搜索、提取与爬取
# 获取地址：https://firecrawl.dev/
# FIRECRAWL_API_KEY=


# FAL.ai API 密钥 - 图像生成
# 获取地址：https://fal.ai/
# FAL_KEY=

# Honcho - 跨会话 AI 原生用户建模（可选）
# 在多次会话和工具间构建对用户的持久理解。
# 获取地址：https://app.honcho.dev
# 还需要 ~/.honcho/config.json 中设置 enabled=true（详见 README）。
# HONCHO_API_KEY=

# =============================================================================
# 终端工具配置
# =============================================================================
# 后端类型："local"（本地）、"singularity"、"docker"、"modal" 或 "ssh"
# 终端后端在 ~/.hermes/config.yaml（terminal.backend）中配置。
# 使用 'hermes setup' 或 'hermes config set terminal.backend docker' 修改。
# 支持：local、docker、singularity、modal、ssh
#
# 仅在需要强制指定后端而不修改 config.yaml 时在此覆盖：
# TERMINAL_ENV=local

# 覆盖容器运行时二进制文件（例如使用 Podman 代替 Docker）。
# 适用于 Docker 存储驱动不可用或损坏的系统。
# HERMES_DOCKER_BINARY=/usr/local/bin/podman

# 容器镜像（用于 singularity/docker/modal 后端）
# TERMINAL_DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
# TERMINAL_SINGULARITY_IMAGE=docker://nikolaik/python-nodejs:python3.11-nodejs20
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20


# 终端命令的工作目录
# 本地后端："." 表示当前目录（自动解析）
# 远程后端（ssh/docker/modal/singularity）：使用目标环境内的绝对路径，
#   或留空使用后端默认值（modal 为 /root，docker 为 /，ssh 为 ~）。
#   请勿使用宿主机本地路径。
# 通常由 config.yaml（terminal.cwd）管理 —— 取消注释以覆盖
# TERMINAL_CWD=.

# 默认命令超时时间（秒）
TERMINAL_TIMEOUT=60

# 不活跃环境自动清理时间（秒）
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# SSH 远程执行（用于 TERMINAL_ENV=ssh）
# =============================================================================
# 通过 SSH 在远程服务器上运行终端命令。
# Agent 代码留在本机，命令在远程执行。
#
# 安全优势：
# - Agent 无法读取你的 .env 文件（API 密钥受保护）
# - Agent 无法修改自身代码
# - 远程服务器充当隔离沙箱
# - 可安全地在远程配置免密 sudo
#
# TERMINAL_SSH_HOST=192.168.1.100
# TERMINAL_SSH_USER=agent
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_KEY=~/.ssh/id_rsa

# =============================================================================
# SUDO 支持（适用于所有终端后端）
# =============================================================================
# 设置后，通过 `sudo -S` 管道传递密码来启用 sudo 命令。
# 适用于：local、docker、singularity、modal 和 ssh 后端。
#
# 安全警告：密码以明文存储。仅在可信机器上使用。
#
# 替代方案：
# - SSH 后端：在远程服务器上配置免密 sudo
# - 容器：在容器内以 root 用户运行（无需 sudo）
# - 本地：通过 /etc/sudoers 为特定命令授权
# - CLI：留空 —— 将以交互方式提示输入，超时 45 秒
#
# SUDO_PASSWORD=你的密码

# =============================================================================
# MODAL 云后端（可选 - 用于 TERMINAL_ENV=modal）
# =============================================================================
# Modal 使用 CLI 认证，无需环境变量。
# 运行：pip install modal && modal setup
# 将通过浏览器认证并在本地存储凭证。
# .env 中无需 API 密钥 —— Modal 自动处理认证。

# =============================================================================
# 浏览器工具配置（agent-browser + Browserbase）
# =============================================================================
# 浏览器自动化需要 Browserbase 云服务进行远程浏览器执行。
# 允许 Agent 浏览网页、填写表单和提取信息。
#
# 隐身模式：
# - 基础隐身：始终启用（随机指纹、自动验证码解决）
# - 高级隐身：需要 BROWSERBASE_ADVANCED_STEALTH=true（仅 Scale 计划）

# Browserbase API 密钥 - 云浏览器执行
# 获取地址：https://browserbase.com/
# BROWSERBASE_API_KEY=

# Browserbase 项目 ID - 从 Browserbase 仪表盘获取
# BROWSERBASE_PROJECT_ID=

# 启用住宅代理以提高验证码通过率（默认：true）
# 通过住宅 IP 路由流量，显著提高成功率
BROWSERBASE_PROXIES=true

# 启用高级隐身模式（默认：false，需要 Scale 计划）
# 使用定制 Chromium 构建以避免机器人检测
BROWSERBASE_ADVANCED_STEALTH=false

# 浏览器会话超时时间（秒，默认：300）
# 会话在此时间不活跃后被清理
BROWSER_SESSION_TIMEOUT=300

# 浏览器不活跃超时 - 自动清理不活跃会话（默认：120 = 2 分钟）
# 浏览器会话在无活动后自动关闭
BROWSER_INACTIVITY_TIMEOUT=120

# =============================================================================
# 会话日志
# =============================================================================
# 会话轨迹自动保存到 logs/ 目录
# 格式：logs/session_YYYYMMDD_HHMMSS_UUID.json
# 包含完整的对话历史（轨迹格式），用于调试/回放

# =============================================================================
# 语音转写与 OpenAI TTS
# =============================================================================
# 用于语音消息转写（Whisper）和 OpenAI TTS 语音合成。
# 直接使用 OpenAI API（不通过 OpenRouter）。
# 命名为 VOICE_TOOLS_OPENAI_KEY 以避免与 OpenRouter 冲突。
# 获取地址：https://platform.openai.com/api-keys
# VOICE_TOOLS_OPENAI_KEY=

# =============================================================================
# Slack 集成
# =============================================================================
# Slack 机器人令牌 - 从 Slack 应用设置中获取（OAuth & Permissions）
# 获取地址：https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-...

# Slack 应用令牌 - 用于 Socket Mode（应用级令牌）
# SLACK_APP_TOKEN=xapp-...

# Slack 允许的用户（逗号分隔的用户 ID）
# SLACK_ALLOWED_USERS=

# =============================================================================
# Telegram 集成
# =============================================================================
# Telegram 机器人令牌 - 从 @BotFather 获取（https://t.me/BotFather）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=                  # 逗号分隔的用户 ID
# TELEGRAM_HOME_CHANNEL=                   # 定时任务投递的默认聊天
# TELEGRAM_HOME_CHANNEL_NAME=              # 主频道显示名称

# Webhook 模式（可选 —— 用于 Fly.io/Railway 等云部署）
# 默认使用长轮询。设置 TELEGRAM_WEBHOOK_URL 切换到 webhook 模式。
# TELEGRAM_WEBHOOK_URL=https://my-app.fly.dev/telegram
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=                 # 生产环境建议设置

# WhatsApp（内置 Baileys 桥接 —— 运行 `hermes whatsapp` 配对）
# WHATSAPP_ENABLED=false
# WHATSAPP_ALLOWED_USERS=15551234567

# 邮件（IMAP/SMTP —— 以 Hermes 身份收发邮件）
# Gmail 用户：启用两步验证 → 在 https://myaccount.google.com/apppasswords 创建应用密码
# EMAIL_ADDRESS=hermes@gmail.com
# EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_POLL_INTERVAL=15
# EMAIL_ALLOWED_USERS=your@email.com
# EMAIL_HOME_ADDRESS=your@email.com

# 网关全局设置：允许所有用户（默认：false = 拒绝未授权用户）
# 仅在你有意开放访问时设为 true。
# GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# 回复节奏
# =============================================================================
# 消息平台上的仿人类延迟，让机器人显得不那么生硬。
# HERMES_HUMAN_DELAY_MODE=off     # off（关闭）| natural（自然）| custom（自定义）
# HERMES_HUMAN_DELAY_MIN_MS=800   # 最小延迟（毫秒，自定义模式）
# HERMES_HUMAN_DELAY_MAX_MS=2500  # 最大延迟（毫秒，自定义模式）

# =============================================================================
# 调试选项
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# 上下文压缩（自动缩减过长对话）
# =============================================================================
# 当对话接近模型的上下文限制时，中间轮次会被自动摘要以释放空间。
#
# 上下文压缩在 ~/.hermes/config.yaml 的 compression: 下配置：
# CONTEXT_COMPRESSION_ENABLED=true        # 启用自动压缩（默认：true）
# CONTEXT_COMPRESSION_THRESHOLD=0.85      # 达到上下文限制的 85% 时触发压缩
# 摘要模型在 config.yaml 的 compression.summary_model 中设置（默认：google/gemini-3-flash-preview）

# =============================================================================
# RL 强化学习训练（Tinker + Atropos）
# =============================================================================
# 使用 Tinker API 对语言模型进行强化学习训练。
# 需要运行 rl-server（来自 tinker-atropos 包）。

# Tinker API 密钥 - RL 训练服务
# 获取地址：https://tinker-console.thinkingmachines.ai/keys
# TINKER_API_KEY=

# Weights & Biases API 密钥 - 实验追踪与指标
# 获取地址：https://wandb.ai/authorize
# WANDB_API_KEY=

# RL API 服务器地址（默认：http://localhost:8080）
# 如果 rl-server 运行在其他主机/端口上则修改此项
# RL_API_URL=http://localhost:8080

# =============================================================================
# 技能中心（GitHub 集成，用于技能搜索/安装/发布）
# =============================================================================

# GitHub 个人访问令牌 —— 提高技能搜索/安装的 API 速率限制
# 获取地址：https://github.com/settings/tokens（推荐使用细粒度令牌）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub App 凭证（可选 —— 用于 PR 上的机器人身份）
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=

# Groq API 密钥（免费层 —— 用于语音模式中的 Whisper STT）
# GROQ_API_KEY=

# =============================================================================
# STT 语音转文字提供商选择
# =============================================================================
# 默认 STT 提供商为 "local"（faster-whisper）—— 在本机运行，无需 API 密钥。
# 安装：pip install faster-whisper
# 模型在首次使用时自动下载（"base" 约 150 MB）。
# 要使用云提供商，请设置上方的 GROQ_API_KEY 或 VOICE_TOOLS_OPENAI_KEY。
# 提供商优先级：本地 > Groq > OpenAI
# 在 config.yaml 中配置：stt.provider: local | groq | openai

# =============================================================================
# STT 高级覆盖（可选）
# =============================================================================
# 按提供商覆盖默认 STT 模型（通常在 config.yaml 的 stt.model 中设置）
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_OPENAI_MODEL=whisper-1

# 覆盖 STT 提供商端点（用于代理或自托管实例）
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# STT_OPENAI_BASE_URL=https://api.openai.com/v1
